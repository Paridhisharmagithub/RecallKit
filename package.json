{
  "name": "recallkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "concurrently -k -n WEB,API -c magenta,cyan \"vite --host 0.0.0.0\" \"node server/index.js\"",
    "dev": "npm start",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start:prod": "node server/index.js",
    "check": "node --check server/index.js && node --check server/groq.js && node --check shared/studySchema.js",
    "test": "node --test",
    "test:groq": "node test-groq.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "1.68.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.4.0"
  }
}
